# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Groq (LLM). llama-3.3-70b-versatile - check your account's per-model rate
# limits (Groq dashboard) before switching to a smaller model; a lower
# tokens-per-minute cap on a smaller model can throttle real conversations
# more than the larger model's own generation speed would ever cost you.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Caps every response's length - keeps replies short/natural and directly
# reduces per-turn token usage against Groq's daily quota.
GROQ_MAX_TOKENS=120

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# CRM API (backend/api - Node/TS service)
CRM_API_BASE_URL=http://localhost:4000
# Must match backend/api/.env's SERVICE_API_KEY exactly.
CRM_SERVICE_API_KEY=

# Twilio (outbound/cold-calling). Run bot.py with `-t twilio -x <public-host>`
# (e.g. an ngrok hostname) to serve the TwiML webhook route pipecat's own
# runner registers automatically. See trigger_outbound_call.py to originate calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# The public TwiML webhook URL Twilio fetches once a callee answers - same
# proxy host as -x above, e.g. https://<ngrok-host>/
TWILIO_TWIML_WEBHOOK_URL=
