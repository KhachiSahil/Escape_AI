# CRM API - Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string. If using Neon: use the NON-pooled endpoint
# (no "-pooler" in the hostname) for both DATABASE_URL and DIRECT_URL below -
# Neon's pgbouncer-style pooled endpoint handles this app's interactive
# `$transaction` (round-robin escalation assignment) poorly under concurrent
# load (Prisma error P2028). DIRECT_URL is also required by Prisma Migrate.
# If using Neon's free/serverless tier, the compute auto-suspends after
# idling and can take several seconds to resume on the next query - append
# `?connect_timeout=15` (or higher) to DATABASE_URL so the first request
# after idle doesn't fail with a Prisma connection timeout that looks like a
# generic "write failed" error with no indication the DB was just waking up.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/escape_ai_crm?connect_timeout=15
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/escape_ai_crm?connect_timeout=15

# Secret used to sign employee/admin JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Shared secret the Python voice agent uses to call this API.
# Generate independently from JWT_SECRET (different trust boundary) with the
# same command above. Must match backend/src/server/.env's CRM_SERVICE_API_KEY.
SERVICE_API_KEY=

PORT=4000

# CORS origin for the frontend, and cookie behavior.
CORS_ORIGIN=http://localhost:5173

# Email notifications (escalation assigned / lead reassigned). Optional -
# if unset, sendEmail() logs a warning and no-ops rather than throwing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
# Fallback recipient for "escalation queued, no employee available" emails.
ADMIN_NOTIFICATION_EMAIL=
