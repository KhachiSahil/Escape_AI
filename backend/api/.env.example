# CRM API - Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string. If using Neon: use the NON-pooled endpoint
# (no "-pooler" in the hostname) for both DATABASE_URL and DIRECT_URL below -
# Neon's pgbouncer-style pooled endpoint handles this app's interactive
# `$transaction` (round-robin escalation assignment) poorly under concurrent
# load (Prisma error P2028). DIRECT_URL is also required by Prisma Migrate.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/escape_ai_crm
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/escape_ai_crm

# Secret used to sign employee/admin JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Shared secret the Python voice agent uses to call this API.
# Generate independently from JWT_SECRET (different trust boundary) with the
# same command above. Must match backend/src/server/.env's CRM_SERVICE_API_KEY.
SERVICE_API_KEY=

PORT=4000
